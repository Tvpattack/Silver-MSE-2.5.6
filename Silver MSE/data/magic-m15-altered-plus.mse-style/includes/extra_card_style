		left: 165
		top: 472
		width: 46
		height: 26
		z index: 12
		visible: { is_rare() and styling.use_holofoil_stamps and (is_devoid() or is_devoid2() or not is_clear()) and not use_porthole() and use_altered_plus_holofoil() and not is_frontier() }
